# Never put private keys or seed phrases in this file.
APP_ENV=development
APP_MODE=FIXTURE
LOG_LEVEL=INFO

# Ethereum current-state / historical access.
ETH_RPC_URL=
ETH_ARCHIVE_RPC_URL=
GRAPH_API_KEY=

# Terra 2022 historical-source configuration.
# TERRA_ARCHIVE_LCD_URL points at a Terra Classic historical LCD/RPC if you have one.
# TERRA_HISTORY_DATA_URL may point at a normalized JSON/CSV historical provider whose
# rows follow docs/data/terra_hourly_state.csv.
# CURVE_HISTORY_DATA_URL and BRIDGE_FLOW_DATA_URL are optional normalized historical
# providers for the secondary Ethereum/bridge channels.
TERRA_ARCHIVE_LCD_URL=
TERRA_HISTORY_DATA_URL=
CURVE_HISTORY_DATA_URL=
BRIDGE_FLOW_DATA_URL=

DATABASE_URL=sqlite:///./defi_stress.db
REDIS_URL=redis://localhost:6379/0
ASYNC_BACKEND=local
COINGECKO_API_KEY=
DEFILLAMA_API_URL=https://coins.llama.fi
CHAIN_ID=1
DISCOVERY_LOOKBACK_BLOCKS=50000
BORROWER_MAX_USERS=1000
RPC_BATCH_SIZE=50
RPC_BLOCK_CHUNK_SIZE=2000
UNISWAP_TICK_WORD_RADIUS=4
NEXT_PUBLIC_API_URL=http://localhost:8000
